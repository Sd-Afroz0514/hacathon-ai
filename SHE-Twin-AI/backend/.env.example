# ==============================================================================
# SHE TWIN AI — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in your Supabase credentials.
# NEVER commit your actual .env file or database passwords to Git!

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Connection Strings
# ------------------------------------------------------------------------------
# Note: If your password contains special characters (e.g. @, #, %, $, &),
# you MUST URL-encode them (e.g. '@' -> '%40', '#' -> '%23', '%' -> '%25').
#
# Supabase PostgreSQL - Transaction Pooler (Port 6543 / PgBouncer) - Used by running FastAPI app
DATABASE_URL=postgresql+psycopg://postgres.<PROJECT-REF>:<URL-ENCODED-PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase PostgreSQL - Session Pooler (Port 5432) - Used for Alembic migrations
DIRECT_URL=postgresql+psycopg://postgres.<PROJECT-REF>:<URL-ENCODED-PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# 2. Application & JWT Authentication Configuration
# ------------------------------------------------------------------------------
APP_ENV=development
DEBUG=true
SECRET_KEY=REPLACE_WITH_A_SECURE_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# 3. CORS Settings (Allowed Frontend Origins)
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 4. Optional Supabase API Credentials
# ------------------------------------------------------------------------------
SUPABASE_URL=https://<PROJECT-REF>.supabase.co
SUPABASE_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ------------------------------------------------------------------------------
# 5. File Upload Storage
# ------------------------------------------------------------------------------
UPLOAD_DIR=../database/uploads

# ------------------------------------------------------------------------------
# 6. Optional External AI Providers (Synthetic Clinical Parser active if omitted)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
